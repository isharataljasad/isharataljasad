      "destination": "/about.html"
    },
    {
      "source": "/method",
      "destination": "/method.html"
    },
    {
      "source": "/method/",
      "destination": "/method.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/contact/",
      "destination": "/contact.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/faq/",
      "destination": "/faq.html"
    },
    {
      "source": "/for-professionals",
      "destination": "/for-professionals.html"
    },
    {
      "source": "/for-professionals/",
