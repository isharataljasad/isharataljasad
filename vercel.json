{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://umoaquvxkoagmirascgm.supabase.co; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), interest-cohort=(), browsing-topics=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    { "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "private, max-age=31536000, immutable" }] },
    { "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "private, max-age=0, must-revalidate" }] },
    { "source": "/style.css",
      "headers": [{ "key": "Cache-Control", "value": "private, max-age=0, must-revalidate" }] },
    { "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "private, max-age=0, must-revalidate" }] }
  ]
}
