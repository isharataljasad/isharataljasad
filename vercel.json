      "destination": "/privacy.html"
    },
    {
      "source": "/privacy/",
      "destination": "/privacy.html"
    },
    {
      "source": "/updates",
      "destination": "/updates.html"
    },
    {
      "source": "/updates/",
      "destination": "/updates.html"
